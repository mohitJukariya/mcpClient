{
    "$schema": "https://json.schemastore.org/nest-cli",
    "collection": "@nestjs/schematics",
    "sourceRoot": "src",
    "entryFile": "main",
    "compilerOptions": {
        "deleteOutDir": true,
        "assets": [
            "**/*.html",
            "**/*.json"
        ],
        "watchAssets": true,
        "webpack": true
    }
}